---
---
<div class="topology-wrapper">
  <div id="graph-3d-container"></div>
  <div class="topology-overlay">
    <h4>NETWORK TOPOLOGY</h4>
    <div class="legend">
      <div class="legend-item"><span class="dot" style="background: #00ff66;"></span> Edge Agent</div>
      <div class="legend-item"><span class="dot" style="background: #40e24c;"></span> Secure Proxy</div>
      <div class="legend-item"><span class="dot" style="background: #80c633;"></span> Control Plane</div>
      <div class="legend-item"><span class="dot" style="background: #c0a919;"></span> NATS Core</div>
      <div class="legend-item"><span class="dot" style="background: #ff8c00;"></span> Threat Intel</div>
    </div>
  </div>
</div>

<script>
  import ForceGraph3D from '3d-force-graph';
  import * as THREE from 'three';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('graph-3d-container');
    if (!container) return;

    const nodes = [
      { id: 'edge-agent', name: 'Edge Agent', group: 1, color: '#00ff66', val: 6 },
      { id: 'envoy', name: 'Secure Proxy', group: 2, color: '#40e24c', val: 8 },
      { id: 'control-plane', name: 'Control Plane', group: 3, color: '#80c633', val: 6 },
      { id: 'nats', name: 'NATS Core', group: 4, color: '#c0a919', val: 4 },
      { id: 'ai-orchestrator', name: 'Threat Intel', group: 5, color: '#ff8c00', val: 5 }
    ];

    const links = [
      { source: 'edge-agent', target: 'envoy', color: 'rgba(64,226,76,0.2)' },
      { source: 'envoy', target: 'control-plane', color: 'rgba(128,198,51,0.2)' },
      { source: 'control-plane', target: 'nats', color: 'rgba(192,169,25,0.2)' },
      { source: 'ai-orchestrator', target: 'nats', color: 'rgba(255,140,0,0.2)' }
    ];

    const Graph = ForceGraph3D()(container)
      .graphData({ nodes, links })
      .backgroundColor('rgba(0,0,0,0)') 
      .nodeLabel('name')
      .nodeColor(d => d.color)
      .nodeRelSize(5)
      .nodeResolution(32)
      .linkDirectionalParticles(0) 
      .linkDirectionalParticleSpeed(0.015)
      .linkDirectionalParticleWidth(3)
      .linkColor(d => d.color)
      .width(container.clientWidth)
      .height(container.clientHeight);
    
    Graph.cameraPosition({ z: 120 });

    try {
      const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 1, 0.1);
      bloomPass.strength = 2.0;
      bloomPass.radius = 0.5;
      bloomPass.threshold = 0.1;
      Graph.postProcessingComposer().addPass(bloomPass);
    } catch(e) {
      console.warn("BloomPass not supported in this version of 3d-force-graph", e);
    }

    window.addEventListener('resize', () => {
      Graph.width(container.clientWidth);
      Graph.height(container.clientHeight);
    });

    let isTrafficAnimating = false;
    window.triggerNetworkTraffic = () => {
      if (isTrafficAnimating) return;
      isTrafficAnimating = true;

      const currentData = Graph.graphData();
      
      const flowLinks = [
        { source: 'edge-agent', target: 'envoy', color: '#40e24c' },
        { source: 'envoy', target: 'control-plane', color: '#80c633' },
        { source: 'control-plane', target: 'nats', color: '#c0a919' },
        { source: 'nats', target: 'ai-orchestrator', color: '#ff8c00' }
      ];
      
      Graph.graphData({
        nodes: currentData.nodes,
        links: [...currentData.links, ...flowLinks]
      });

      // Enable particles on new links
      Graph.linkDirectionalParticles(link => flowLinks.includes(link) ? 3 : 0);
      Graph.linkDirectionalParticleColor(link => flowLinks.includes(link) ? link.color : 'rgba(255,255,255,0)');

      setTimeout(() => {
        const freshData = Graph.graphData();
        Graph.graphData({
          nodes: freshData.nodes,
          links: freshData.links.filter(l => !flowLinks.includes(l))
        });
        Graph.linkDirectionalParticles(0);
        isTrafficAnimating = false;
      }, 1500);
    };

    window.addEventListener('topology-alert', (e) => {
      if (e.detail.type === 'QUARANTINED') {
        const currentData = Graph.graphData();
        const originalNodes = [...currentData.nodes];

        // Highlight AI Orchestrator and Edge Agent in Red
        const newNodes = currentData.nodes.map(n => {
          if (n.id === 'edge-agent' || n.id === 'ai-orchestrator') {
            return { ...n, color: '#ff3333', val: n.val * 1.5 };
          }
          return n;
        });

        Graph.graphData({ nodes: newNodes, links: currentData.links });

        // Add a red alert link between AI and Edge Agent to signify action
        const alertLink = { source: 'ai-orchestrator', target: 'edge-agent', color: '#ff3333' };
        Graph.graphData({
          nodes: newNodes,
          links: [...currentData.links, alertLink]
        });

        Graph.linkDirectionalParticles(link => link === alertLink ? 5 : 0);
        Graph.linkDirectionalParticleColor(() => '#ff3333');

        // Restore after 3 seconds
        setTimeout(() => {
          Graph.graphData({ nodes, links }); // Restore from original constants
          Graph.linkDirectionalParticles(0);
        }, 3000);
      }
    });
  });
</script>

<style>
  .topology-wrapper {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(5, 10, 17, 0.4) 0%, rgba(2, 5, 10, 0.8) 100%);
    border: 1px solid rgba(0, 229, 255, 0.15);
  }

  #graph-3d-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .topology-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    pointer-events: none;
    background: rgba(2, 5, 10, 0.7);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid rgba(0, 229, 255, 0.15);
    backdrop-filter: blur(8px);
  }

  .topology-overlay h4 {
    margin: 0 0 0.5rem 0;
    font-size: 0.9rem;
    color: #f8fafc;
    font-family: monospace;
  }

  .legend {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #cbd5e1;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
</style>
