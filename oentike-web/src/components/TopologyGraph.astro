---
---
<div class="topology-wrapper">
  <div id="graph-3d-container"></div>
  <div class="topology-overlay">
    <h4>Live Network Topology</h4>
    <div class="legend">
      <div class="legend-item"><span class="dot" style="background: #10b981;"></span> Edge Agent</div>
      <div class="legend-item"><span class="dot" style="background: #ff7b00;"></span> Envoy Proxy</div>
      <div class="legend-item"><span class="dot" style="background: #6366f1;"></span> Control Plane</div>
      <div class="legend-item"><span class="dot" style="background: #ec4899;"></span> AI Orchestrator</div>
    </div>
  </div>
</div>

<script>
  import ForceGraph3D from '3d-force-graph';
  import * as THREE from 'three';
  import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('graph-3d-container');
    if (!container) return;

    const nodes = [
      { id: 'edge-agent', name: 'Edge Agent', group: 1, color: '#10b981', val: 6 },
      { id: 'envoy', name: 'Envoy (WASM)', group: 2, color: '#ff7b00', val: 8 },
      { id: 'control-plane', name: 'Control Plane', group: 3, color: '#6366f1', val: 6 },
      { id: 'nats', name: 'NATS Msg Bus', group: 4, color: '#3b82f6', val: 4 },
      { id: 'ai-orchestrator', name: 'LangGraph AI', group: 5, color: '#ec4899', val: 5 }
    ];

    const links = [
      { source: 'edge-agent', target: 'envoy', color: 'rgba(255,255,255,0.1)' },
      { source: 'envoy', target: 'control-plane', color: 'rgba(255,255,255,0.1)' },
      { source: 'control-plane', target: 'nats', color: 'rgba(255,255,255,0.1)' },
      { source: 'ai-orchestrator', target: 'nats', color: 'rgba(255,255,255,0.1)' }
    ];

    const Graph = ForceGraph3D()(container)
      .graphData({ nodes, links })
      .backgroundColor('rgba(0,0,0,0)') 
      .nodeLabel('name')
      .nodeColor(d => d.color)
      .nodeRelSize(5)
      .nodeResolution(32)
      .linkDirectionalParticles(0) 
      .linkDirectionalParticleSpeed(0.015)
      .linkDirectionalParticleWidth(3)
      .linkColor(d => d.color)
      .width(container.clientWidth)
      .height(container.clientHeight);
    
    Graph.cameraPosition({ z: 120 });

    try {
      const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 1, 0.1);
      bloomPass.strength = 1.2;
      bloomPass.radius = 0.5;
      bloomPass.threshold = 0.1;
      Graph.postProcessingComposer().addPass(bloomPass);
    } catch(e) {
      console.warn("BloomPass not supported in this version of 3d-force-graph", e);
    }

    window.addEventListener('resize', () => {
      Graph.width(container.clientWidth);
      Graph.height(container.clientHeight);
    });

    window.triggerNetworkTraffic = () => {
      // Create a burst of traffic particles through the network
      const currentData = Graph.graphData();
      
      const flowLinks = [
        { source: 'edge-agent', target: 'envoy', color: '#10b981' },
        { source: 'envoy', target: 'control-plane', color: '#6366f1' },
        { source: 'control-plane', target: 'nats', color: '#3b82f6' },
        { source: 'nats', target: 'ai-orchestrator', color: '#ec4899' }
      ];
      
      Graph.graphData({
        nodes: currentData.nodes,
        links: [...currentData.links, ...flowLinks]
      });

      // Enable particles on new links
      Graph.linkDirectionalParticles(link => flowLinks.includes(link) ? 3 : 0);
      Graph.linkDirectionalParticleColor(link => flowLinks.includes(link) ? link.color : 'rgba(255,255,255,0)');

      setTimeout(() => {
        Graph.graphData({
          nodes: currentData.nodes,
          links: currentData.links.filter(l => !flowLinks.includes(l))
        });
        Graph.linkDirectionalParticles(0);
      }, 1500);
    };
  });
</script>

<style>
  .topology-wrapper {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #graph-3d-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .topology-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    pointer-events: none;
    background: rgba(15, 23, 42, 0.7);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
  }

  .topology-overlay h4 {
    margin: 0 0 0.5rem 0;
    font-size: 0.9rem;
    color: #f8fafc;
    font-family: 'Outfit', sans-serif;
  }

  .legend {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #cbd5e1;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
</style>
