---
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import ShellPrefs from "../../components/ShellPrefs.astro";
import QuietFooter from "../../components/QuietFooter.astro";
import { atlasCards, atlasPack } from "../../data/atlas";
import EdibilityBadge from '../../components/EdibilityBadge.astro';
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            id="page-description"
            name="description"
            content="Oentike - atlas gatunków pilotażowych."
        />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/oentike-logo.svg" />
        <title>Oentike - Atlas</title>
    </head>
    <body data-i18n-title="atlas.metaTitle">
        <SiteHeader active="atlas" />
        <main class="atlas-page">
            <section class="intro atlas-intro">
                <div>
                    <p class="eyebrow" data-i18n="atlas.eyebrow">ATLAS</p>
                    <h1 data-i18n="atlas.title">Gatunki pilotażowe</h1>
                    <p class="lead" data-i18n="atlas.lead">
                        Karty wiedzy - nazwa potoczna pierwsza, łacina obok. Bez
                        oceny warunków i bez identyfikacji ze zdjęcia.
                    </p>
                </div>
                <span class="tag">pack {atlasPack.version}</span>
            </section>

            <p class="caption" data-name-pl="Oznaczenia dotyczą gatunków, nie rozpoznania znalezionego okazu. Nie spożywaj grzybów na podstawie ikon ani ilustracji." data-name-en="Labels describe species, not identification of a found specimen. Do not eat mushrooms based on icons or illustrations.">Oznaczenia dotyczą gatunków, nie rozpoznania znalezionego okazu. Nie spożywaj grzybów na podstawie ikon ani ilustracji.</p>
            <ul class="atlas-list">
                {
                    atlasCards.map((card) => (
                        <li>
                            <a class="atlas-row" href={`/atlas/${card.slug}`}>
                                <span>
                                    <strong
                                        data-name-pl={card.names.pl}
                                        data-name-en={card.names.en}
                                    >
                                        {card.names.pl}
                                    </strong>
                                    {card.scientific_name ? (
                                        <em>{card.scientific_name}</em>
                                    ) : null}
                                </span>
                                <EdibilityBadge safety={card.edibility} />
                            </a>
                        </li>
                    ))
                }
            </ul>

            <p class="caption" data-i18n="atlas.pendingNote">
                Ilustracje są schematyczne. Źródła opisów znajdziesz na kartach gatunków.
            </p>
        </main>
        <QuietFooter />
        <ShellPrefs />
    </body>
</html>

<style>
 .atlas-row{padding:18px 0;gap:24px;}
 .atlas-row>span:first-child{min-width:0;}
 @media(min-width:601px){
  .atlas-row :global(.edibility-badge){width:13rem;flex:none;}
 }
 @media(max-width:600px){
  .atlas-row{flex-direction:column;align-items:flex-start;gap:10px;}
  .atlas-row :global(.edibility-label){max-width:none;}
 }
</style>
