---
import "../styles/global.css";
import MushroomIcon from "../components/MushroomIcon.astro";

const factors = [
    {
        id: "precipitation",
        label: "factors.rain",
        period: "factors.rainPeriod",
        unit: "mm",
    },
    {
        id: "soil_temperature",
        label: "factors.soil",
        period: "factors.soilPeriod",
        unit: "°C",
    },
    {
        id: "soil_moisture",
        label: "factors.humidity",
        period: "factors.humidityPeriod",
        unit: "m3/m3",
    },
];
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta
            id="page-description"
            name="description"
            content="Oentike - przejrzysta analiza warunków grzybowych dla polskich lasów."
        />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/oentike-logo.svg" />
        <title>Oentike - warunki grzybowe</title>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                try {
                    root.dataset.theme =
                        localStorage.getItem("oentike-theme") ||
                        (matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light");
                    root.dataset.size =
                        localStorage.getItem("oentike-size") || "medium";
                    root.dataset.contrast =
                        localStorage.getItem("oentike-contrast") || "normal";
                    root.dataset.tempUnit =
                        localStorage.getItem("oentike-temp-unit") === "F"
                            ? "F"
                            : "C";
                } catch {
                    root.dataset.theme = "light";
                    root.dataset.size = "medium";
                    root.dataset.contrast = "normal";
                    root.dataset.tempUnit = "C";
                }
            })();
        </script>
    </head>
    <body>
        <header class="site-header">
            <a
                class="brand"
                href="/"
                aria-label="Oentike - strona główna"
                data-i18n-aria="meta.home"
            >
                <span>Oen</span>
                <MushroomIcon class="brand-mark" variant="brand" />
                <span>ke</span>
            </a>

            <nav aria-label="Główna nawigacja" data-i18n-aria="meta.navigation">
                <a href="#warunki" data-i18n="nav.conditions">Warunki</a>
                <a href="#obszar" data-i18n="nav.area">Obszar</a>
            </nav>

            <div
                class="ux-controls"
                aria-label="Ustawienia wyglądu"
                data-i18n-aria="controls.appearance"
            >
                <div
                    class="language-control"
                    role="group"
                    aria-label="Język"
                    data-i18n-aria="controls.language"
                >
                    <button type="button" data-language="pl">PL</button>
                    <button type="button" data-language="en">EN</button>
                </div>
                <div
                    class="size-control"
                    role="group"
                    aria-label="Rozmiar interfejsu"
                    data-i18n-aria="controls.size"
                >
                    <button
                        type="button"
                        data-size="small"
                        aria-label="Mały interfejs"
                    >
                        <MushroomIcon class="small" />
                    </button>
                    <button
                        type="button"
                        data-size="medium"
                        aria-label="Średni interfejs"
                    >
                        <MushroomIcon class="medium" />
                    </button>
                    <button
                        type="button"
                        data-size="large"
                        aria-label="Duży interfejs"
                    >
                        <MushroomIcon class="large" />
                    </button>
                </div>
                <button
                    class="contrast-toggle"
                    id="contrast-toggle"
                    type="button"
                    aria-label="Włącz wysoki kontrast"
                    aria-pressed="false"
                >
                    <MushroomIcon class="contrast" />
                </button>
                <button
                    class="theme-toggle"
                    id="theme-toggle"
                    type="button"
                    aria-label="Włącz ciemny motyw"
                    aria-pressed="false"
                >
                    <MushroomIcon class="theme" variant="theme" />
                </button>
            </div>
        </header>

        <main>
            <section class="intro">
                <div>
                    <p class="eyebrow" id="current-date">LASY JANOWSKIE</p>
                    <h1 data-i18n="intro.title">Warunki dla grzybów</h1>
                    <p class="lead" data-i18n="intro.lead">
                        Wyjaśnialna ocena oparta na pogodzie - bez zgadywania i
                        bez ujawniania dokładnych miejsc.
                    </p>
                </div>
                <button
                    class="refresh-button"
                    id="refresh-button"
                    type="button"
                >
                    <svg
                        class="refresh-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M19.3 8.2A8 8 0 1 0 20 15"></path>
                        <path d="M20 4v5.5h-5.5"></path>
                    </svg>
                    <span data-i18n="controls.refresh">Odśwież</span>
                </button>
            </section>

            <section class="condition-card" id="warunki">
                <div class="condition-copy">
                    <div class="section-heading">
                        <p class="eyebrow" data-i18n="condition.eyebrow">
                            OCENA WARUNKÓW
                        </p>
                        <span
                            id="condition-availability"
                            class="availability"
                            data-i18n="condition.unavailable">Brak danych</span
                        >
                    </div>
                    <h2
                        id="condition-title"
                        data-i18n="condition.checkingTitle"
                    >
                        Sprawdzamy gotowość systemu.
                    </h2>
                    <p
                        id="condition-description"
                        data-i18n="condition.checkingDescription"
                    >
                        Ocena pojawi się dopiero po pobraniu kompletnych danych
                        pogodowych.
                    </p>
                    <dl class="metadata">
                        <div>
                            <dt data-i18n="condition.species">Gatunek</dt>
                            <dd class="species-name">
                                <span data-i18n="condition.speciesCommon"
                                    >Borowik szlachetny</span
                                >
                                <small>Boletus edulis</small>
                            </dd>
                        </div>
                        <div>
                            <dt data-i18n="condition.area">Obszar</dt>
                            <dd>Lasy Janowskie 01</dd>
                        </div>
                        <div>
                            <dt data-i18n="condition.updated">Aktualizacja</dt>
                            <dd
                                id="last-check"
                                class="animated-time"
                                aria-live="polite"
                            >
                                --:--
                            </dd>
                        </div>
                    </dl>
                </div>

                <div
                    class="score"
                    id="score-panel"
                    aria-label="Wynik nie został jeszcze obliczony"
                >
                    <span id="score-value">-</span>
                    <small>/ 100</small>
                    <p id="score-caption" data-i18n="condition.notCalculated">
                        Nie obliczono
                    </p>
                </div>
            </section>

            <section class="section-block" aria-labelledby="factors-title">
                <div class="section-title">
                    <div>
                        <p class="eyebrow" data-i18n="factors.eyebrow">
                            DANE WEJŚCIOWE
                        </p>
                        <h2 id="factors-title" data-i18n="factors.title">
                            Składniki oceny
                        </h2>
                    </div>
                    <p data-i18n="factors.note">
                        Brak próbki oznacza brak wyniku.
                    </p>
                </div>

                <div class="factor-list">
                    {
                        factors.map((factor) => (
                            <article class="factor-row">
                                <div>
                                    <strong data-i18n={factor.label} />
                                    <span data-i18n={factor.period} />
                                </div>
                                <p>
                                    <b id={`factor-value-${factor.id}`}>-</b>
                                    {factor.id === "soil_temperature" ? (
                                        <span
                                            class="unit-toggle"
                                            id={`factor-unit-${factor.id}`}
                                            role="group"
                                            aria-label="Jednostka temperatury"
                                            data-i18n-aria="controls.tempUnit"
                                        >
                                            <button
                                                type="button"
                                                data-temp-unit="C"
                                                aria-pressed="true"
                                            >
                                                °C
                                            </button>
                                            <button
                                                type="button"
                                                data-temp-unit="F"
                                                aria-pressed="false"
                                            >
                                                °F
                                            </button>
                                        </span>
                                    ) : (
                                        <span id={`factor-unit-${factor.id}`}>
                                            {factor.unit}
                                        </span>
                                    )}
                                </p>
                                <small
                                    id={`factor-no-samples-${factor.id}`}
                                    data-i18n="factors.noSamples"
                                >
                                    Brak próbek
                                </small>
                            </article>
                        ))
                    }
                </div>
            </section>

            <section class="detail-card area-card" id="obszar">
                <div class="section-title compact">
                    <div>
                        <p class="eyebrow" data-i18n="pilot.eyebrow">
                            OBSZAR PILOTAŻOWY
                        </p>
                        <h2>Lasy Janowskie 01</h2>
                    </div>
                    <span class="tag">10 × 10 km</span>
                </div>

                <div
                    class="cell-preview"
                    id="pilot-map"
                    role="region"
                    aria-label="Mapa oddziałów leśnych w rejonie Lasów Janowskich"
                    data-i18n-aria="pilot.mapAlt"
                ></div>
                <p class="caption">
                    <span data-i18n="pilot.interact"
                        >Przeciągnij i powiększ. Pomarańczowa ramka to komórka
                        10 × 10 km — nie dokładny punkt GPS.</span
                    >
                    <span data-i18n="pilot.sourcePrefix">Dane mapowe:</span>
                    <a
                        href="https://bdl.lasy.gov.pl/portal/uslugi-ogc?v=4"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Bank Danych o Lasach
                    </a>
                    · OSM.
                </p>

                <div class="season">
                    <p class="eyebrow" data-i18n="season.eyebrow">
                        TREND · 9 DNI
                    </p>
                    <h3 data-i18n="season.title">Sezon w danej komórce</h3>
                    <p
                        class="season-range"
                        id="season-range"
                        data-i18n="season.rangeFallback"
                    >
                        Zakres dni pojawi się po zasileniu
                    </p>
                    <div
                        class="season-chart"
                        id="season-chart"
                        role="img"
                        aria-label="Histogram sezonu - brak ocen"
                    >
                    </div>
                    <p class="caption" data-i18n="season.note">
                        Słupki to nasze oceny dla tej komórki - nie mapa Polski
                        i nie obserwacja z lasu. Pusty słupek = brak kompletnych
                        czynników.
                    </p>
                </div>
                <p class="caption pilot-next" data-i18n="pilot.chooseLater">
                    Wybór innego terenu przyjdzie po siatce komórek - na razie
                    tylko Lasy Janowskie.
                </p>
            </section>

            <footer>
                <div class="footer-copy">
                    <p data-i18n="footer.promise">
                        Każda przyszła ocena pokaże pochodzenie danych, wersję
                        algorytmu i poziom pewności.
                    </p>
                    <span data-i18n="footer.version"
                        >Oentike · wersja rozwojowa</span
                    >
                </div>
                <details class="sources-panel" id="zrodla">
                    <summary data-i18n="sources.summary">
                        Na czym oparte są dane
                    </summary>
                    <div class="source-list">
                        <div class="source-row">
                            <span class="source-dot"></span>
                            <div>
                                <strong>PostGIS</strong>
                                <small data-i18n="sources.postgis"
                                    >geometria i szeregi czasowe</small
                                >
                            </div>
                            <b id="database-status" data-i18n="sources.checking"
                                >Sprawdzanie</b
                            >
                        </div>
                        <div class="source-row">
                            <span class="source-dot"></span>
                            <div>
                                <strong>Bank Danych o Lasach</strong>
                                <small data-i18n="sources.bdl"
                                    >granice oddziałów · OGC WMS</small
                                >
                            </div>
                            <b class="connected" data-i18n="sources.official"
                                >Oficjalne</b
                            >
                        </div>
                        <div class="source-row">
                            <span class="source-dot muted"></span>
                            <div>
                                <strong>Open-Meteo</strong>
                                <small data-i18n="sources.weather"
                                    >historia i prognoza pogody</small
                                >
                            </div>
                            <b
                                id="weather-status"
                                class="pending"
                                data-i18n="sources.pending">Do podłączenia</b
                            >
                        </div>
                    </div>
                </details>
            </footer>
        </main>

        <div class="theme-wipe" id="theme-wipe" aria-hidden="true"></div>
        <div class="custom-cursor" id="custom-cursor" aria-hidden="true">
            <span></span>
        </div>

        <script>
            import { gsap } from "gsap";
            import i18next from "i18next";
            import { invoke } from "@tauri-apps/api/core";
            import * as maplibregl from "maplibre-gl";
            import "maplibre-gl/dist/maplibre-gl.css";
            import { resources } from "../i18n";

            // Pilot cell: 10×10 km around the fixture centroid (EPSG:4326).
            const pilotCenter = { lon: 22.189584, lat: 50.60125 };
            const pilotHalfKm = 5;
            const metersPerDegLat = 110_540;
            const metersPerDegLon =
                111_320 * Math.cos((pilotCenter.lat * Math.PI) / 180);
            const dLat = (pilotHalfKm * 1000) / metersPerDegLat;
            const dLon = (pilotHalfKm * 1000) / metersPerDegLon;
            const pilotBounds = {
                west: pilotCenter.lon - dLon,
                south: pilotCenter.lat - dLat,
                east: pilotCenter.lon + dLon,
                north: pilotCenter.lat + dLat,
            };

            const root = document.documentElement;
            const conditionTitle = document.getElementById("condition-title");
            const conditionDescription = document.getElementById(
                "condition-description",
            );
            const databaseStatus = document.getElementById("database-status");
            const weatherStatus = document.getElementById("weather-status");
            const lastCheck = document.getElementById("last-check");
            const refreshButton = document.getElementById("refresh-button");
            const refreshIcon = document.querySelector(".refresh-icon");
            const scoreValue = document.getElementById("score-value");
            const scoreCaption = document.getElementById("score-caption");
            const scorePanel = document.getElementById("score-panel");
            const availabilityBadge = document.getElementById(
                "condition-availability",
            );
            const themeToggle = document.getElementById("theme-toggle");
            const contrastToggle = document.getElementById("contrast-toggle");
            const themeWipe = document.getElementById("theme-wipe");
            const sizeButtons = document.querySelectorAll("[data-size]");
            const languageButtons =
                document.querySelectorAll("[data-language]");
            const reducedMotion = matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            let readinessState = "checking";
            let displayedStamp = "";
            let displayedScore = "";
            let lastConditions = null;
            let lastSeasonDays = null;

            // UI pilot fixture (exact point stays private; one cell only).
            const pilotCellID = "lasy-janowskie-01";
            const pilotSpeciesSlug = "boletus-edulis";
            const pilotTargetDate = "";

            const tempUnitButtons =
                document.querySelectorAll("[data-temp-unit]");

            const factorDefs = [
                { id: "precipitation", unit: "mm" },
                { id: "soil_temperature", unit: "°C" },
                { id: "soil_moisture", unit: "m3/m3" },
            ];

            function tempUnit() {
                return root.dataset.tempUnit === "F" ? "F" : "C";
            }

            function formatFactor(factorId, value) {
                if (typeof value !== "number") return String(value);
                if (factorId === "soil_moisture") return value.toFixed(3);
                if (factorId === "soil_temperature" && tempUnit() === "F") {
                    return ((value * 9) / 5 + 32).toFixed(1);
                }
                if (
                    factorId === "precipitation" ||
                    factorId === "soil_temperature"
                ) {
                    return value.toFixed(1);
                }
                return value.toFixed(2);
            }

            function syncTempUnit() {
                const unit = tempUnit();
                tempUnitButtons.forEach((button) => {
                    button.setAttribute(
                        "aria-pressed",
                        String(button.dataset.tempUnit === unit),
                    );
                });
            }

            const savedLanguage = localStorage.getItem("oentike-language");
            const browserLanguage = navigator.language
                .toLowerCase()
                .startsWith("en")
                ? "en"
                : "pl";
            await i18next.init({
                lng: savedLanguage || browserLanguage,
                fallbackLng: "pl",
                resources,
                interpolation: { escapeValue: false },
            });

            const t = (key) => i18next.t(key);
            const locale = () =>
                i18next.language === "en" ? "en-GB" : "pl-PL";

            function applyTranslations() {
                root.lang = i18next.language;
                document.title = t("meta.title");
                document
                    .getElementById("page-description")
                    .setAttribute("content", t("meta.description"));
                document.querySelectorAll("[data-i18n]").forEach((element) => {
                    element.textContent = t(element.dataset.i18n);
                });
                document
                    .querySelectorAll("[data-i18n-aria]")
                    .forEach((element) => {
                        element.setAttribute(
                            "aria-label",
                            t(element.dataset.i18nAria),
                        );
                    });
                document
                    .querySelectorAll("[data-i18n-alt]")
                    .forEach((element) => {
                        element.setAttribute("alt", t(element.dataset.i18nAlt));
                    });

                const date = new Intl.DateTimeFormat(locale(), {
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                }).format(new Date());
                document.getElementById("current-date").textContent =
                    `${date} · Lasy Janowskie`.toLocaleUpperCase(locale());

                setState(readinessState);
                applyConditionsView(lastConditions);
                renderSeason(lastSeasonDays);
                syncPreferences();
            }

            function syncPreferences() {
                const dark = root.dataset.theme === "dark";
                const highContrast = root.dataset.contrast === "high";
                const activeSize = root.dataset.size || "medium";
                const sizeLabels = {
                    small: t("controls.small"),
                    medium: t("controls.medium"),
                    large: t("controls.large"),
                };

                themeToggle.setAttribute("aria-pressed", String(dark));
                themeToggle.setAttribute(
                    "aria-label",
                    dark ? t("controls.light") : t("controls.dark"),
                );
                themeToggle.title = themeToggle.getAttribute("aria-label");

                contrastToggle.setAttribute(
                    "aria-pressed",
                    String(highContrast),
                );
                contrastToggle.setAttribute(
                    "aria-label",
                    highContrast
                        ? t("controls.contrastOff")
                        : t("controls.contrastOn"),
                );
                contrastToggle.title =
                    contrastToggle.getAttribute("aria-label");

                sizeButtons.forEach((button) => {
                    const size = button.dataset.size;
                    button.setAttribute(
                        "aria-pressed",
                        String(size === activeSize),
                    );
                    button.setAttribute("aria-label", sizeLabels[size]);
                    button.title = sizeLabels[size];
                });
                languageButtons.forEach((button) => {
                    button.setAttribute(
                        "aria-pressed",
                        String(button.dataset.language === i18next.language),
                    );
                });
                syncTempUnit();
            }

            function animatePreferenceChange(callback) {
                if (reducedMotion) {
                    callback();
                    return;
                }

                gsap.timeline()
                    .to("main", {
                        opacity: 0.65,
                        y: 3,
                        duration: 0.12,
                        ease: "power2.in",
                    })
                    .add(callback)
                    .to("main", {
                        opacity: 1,
                        y: 0,
                        duration: 0.28,
                        ease: "power2.out",
                    });
            }

            sizeButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    animatePreferenceChange(() => {
                        root.dataset.size = button.dataset.size;
                        localStorage.setItem(
                            "oentike-size",
                            button.dataset.size,
                        );
                        syncPreferences();
                    });
                    if (!reducedMotion) {
                        gsap.fromTo(
                            button.querySelector(".control-mushroom"),
                            { scale: 0.72, rotate: -7 },
                            {
                                scale: 1,
                                rotate: 0,
                                duration: 0.45,
                                ease: "back.out(2.2)",
                            },
                        );
                    }
                });
            });

            languageButtons.forEach((button) => {
                button.addEventListener("click", async () => {
                    await i18next.changeLanguage(button.dataset.language);
                    localStorage.setItem(
                        "oentike-language",
                        button.dataset.language,
                    );
                    applyTranslations();
                    if (!reducedMotion) {
                        gsap.fromTo(
                            "[data-i18n]",
                            { opacity: 0.35, y: 2 },
                            {
                                opacity: 1,
                                y: 0,
                                duration: 0.28,
                                stagger: 0.006,
                            },
                        );
                    }
                });
            });

            tempUnitButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const unit = button.dataset.tempUnit === "F" ? "F" : "C";
                    root.dataset.tempUnit = unit;
                    localStorage.setItem("oentike-temp-unit", unit);
                    syncTempUnit();
                    applyConditionsView(lastConditions);
                });
            });

            themeToggle.addEventListener("click", () => {
                const nextTheme =
                    root.dataset.theme === "dark" ? "light" : "dark";
                const targetColor =
                    nextTheme === "dark" ? "#101612" : "#f6f5ef";

                if (reducedMotion) {
                    root.dataset.theme = nextTheme;
                    localStorage.setItem("oentike-theme", nextTheme);
                    syncPreferences();
                    return;
                }

                const bounds = themeToggle.getBoundingClientRect();
                gsap.set(themeWipe, {
                    display: "block",
                    opacity: 1,
                    scale: 0,
                    x: bounds.left + bounds.width / 2,
                    y: bounds.top + bounds.height / 2,
                    backgroundColor: targetColor,
                });
                gsap.timeline()
                    .to(themeToggle.querySelector(".control-mushroom"), {
                        scaleY: 0.74,
                        scaleX: 1.12,
                        duration: 0.16,
                        ease: "power2.in",
                    })
                    .to(
                        themeWipe,
                        { scale: 120, duration: 0.52, ease: "power3.inOut" },
                        0,
                    )
                    .call(
                        () => {
                            root.dataset.theme = nextTheme;
                            localStorage.setItem("oentike-theme", nextTheme);
                            syncPreferences();
                        },
                        [],
                        0.3,
                    )
                    .to(themeWipe, { opacity: 0, duration: 0.2 })
                    .to(
                        themeToggle.querySelector(".control-mushroom"),
                        {
                            scaleX: 1,
                            scaleY: 1,
                            duration: 0.38,
                            ease: "elastic.out(1, 0.45)",
                        },
                        0.32,
                    )
                    .set(themeWipe, { display: "none", scale: 0, opacity: 1 });
            });

            contrastToggle.addEventListener("click", () => {
                const nextContrast =
                    root.dataset.contrast === "high" ? "normal" : "high";
                root.dataset.contrast = nextContrast;
                localStorage.setItem("oentike-contrast", nextContrast);
                syncPreferences();
                if (!reducedMotion) {
                    gsap.fromTo(
                        contrastToggle.querySelector(".control-mushroom"),
                        { rotateY: 0 },
                        { rotateY: 360, duration: 0.55, ease: "power3.inOut" },
                    );
                }
            });

            function formatFetchedAt(iso) {
                if (!iso) return "";
                const date = new Date(iso);
                if (Number.isNaN(date.getTime())) return "";
                return new Intl.DateTimeFormat(locale(), {
                    hour: "2-digit",
                    minute: "2-digit",
                    timeZone: "Europe/Warsaw",
                }).format(date);
            }

            function animateStamp(value, ariaLabel) {
                if (!lastCheck) return;
                if (value === displayedStamp) {
                    if (ariaLabel)
                        lastCheck.setAttribute("aria-label", ariaLabel);
                    return;
                }
                displayedStamp = value;

                lastCheck.replaceChildren(
                    ...Array.from(value, (character) => {
                        const span = document.createElement("span");
                        span.textContent = character;
                        span.className = /\d/.test(character)
                            ? "time-digit"
                            : "time-separator";
                        return span;
                    }),
                );
                lastCheck.setAttribute("aria-label", ariaLabel || value);

                if (!reducedMotion) {
                    gsap.from(lastCheck.querySelectorAll(".time-digit"), {
                        yPercent: 90,
                        opacity: 0,
                        duration: 0.42,
                        stagger: 0.025,
                        ease: "back.out(1.7)",
                    });
                }
            }

            function animateScore(value) {
                if (!scoreValue) return;
                const text = value == null ? "-" : String(value);
                if (text === displayedScore) return;
                displayedScore = text;

                if (value == null) {
                    scoreValue.textContent = "-";
                    return;
                }

                scoreValue.replaceChildren(
                    ...Array.from(text, (character) => {
                        const span = document.createElement("span");
                        span.textContent = character;
                        span.className = "score-digit";
                        return span;
                    }),
                );

                if (!reducedMotion) {
                    gsap.from(scoreValue.querySelectorAll(".score-digit"), {
                        yPercent: 90,
                        opacity: 0,
                        duration: 0.42,
                        stagger: 0.04,
                        ease: "back.out(1.7)",
                    });
                }
            }

            function setState(state) {
                readinessState = state;
                if (state === "ready") {
                    conditionTitle.textContent = t("condition.readyTitle");
                    conditionDescription.textContent = t(
                        "condition.readyDescription",
                    );
                    databaseStatus.textContent = t("sources.connected");
                    databaseStatus.className = "connected";
                    return;
                }

                if (state === "unavailable") {
                    conditionTitle.textContent = t("condition.offlineTitle");
                    conditionDescription.textContent = t(
                        "condition.offlineDescription",
                    );
                    databaseStatus.textContent = t("sources.unavailable");
                    databaseStatus.className = "disconnected";
                    return;
                }

                conditionTitle.textContent = t("condition.checkingTitle");
                conditionDescription.textContent = t(
                    "condition.checkingDescription",
                );
                databaseStatus.textContent = t("sources.checking");
                databaseStatus.className = "";
            }

            function setFactorValue(factorId, value, unit) {
                const valueEl = document.getElementById(
                    `factor-value-${factorId}`,
                );
                const unitEl = document.getElementById(
                    `factor-unit-${factorId}`,
                );
                const noSamplesEl = document.getElementById(
                    `factor-no-samples-${factorId}`,
                );
                if (!valueEl || !noSamplesEl) return;

                if (value === null || value === undefined) {
                    valueEl.textContent = "-";
                    if (unitEl && !unitEl.classList.contains("unit-toggle")) {
                        unitEl.textContent = unit ?? "";
                    }
                    noSamplesEl.style.display = "";
                    return;
                }

                valueEl.textContent = formatFactor(factorId, value);
                if (unitEl && !unitEl.classList.contains("unit-toggle")) {
                    unitEl.textContent = unit ?? "";
                }
                noSamplesEl.style.display = "none";
            }

            function parseCivilDate(iso) {
                if (!iso) return null;
                const parts = iso.split("-").map(Number);
                if (parts.length !== 3 || parts.some(Number.isNaN)) return null;
                return new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));
            }

            function seasonDayParts(iso) {
                const date = parseCivilDate(iso);
                if (!date) return { weekday: "-", date: "", isToday: false };
                const weekday = new Intl.DateTimeFormat(locale(), {
                    weekday: "short",
                    timeZone: "UTC",
                })
                    .format(date)
                    .replace(/\.$/, "");
                const day = String(date.getUTCDate()).padStart(2, "0");
                const month = String(date.getUTCMonth() + 1).padStart(2, "0");
                const today = new Date();
                const warsawToday = new Intl.DateTimeFormat("en-CA", {
                    timeZone: "Europe/Warsaw",
                    year: "numeric",
                    month: "2-digit",
                    day: "2-digit",
                }).format(today);
                return {
                    weekday,
                    date: `${day}.${month}`,
                    isToday: iso === warsawToday,
                };
            }

            function fillSeasonCol(col, day) {
                const bar = col.querySelector(".season-bar");
                const scoreEl = col.querySelector(".season-score");
                const weekdayEl = col.querySelector(".season-weekday");
                const dateEl = col.querySelector(".season-date");
                if (!bar || !scoreEl || !weekdayEl || !dateEl) return;
                const scored = day?.status === "ready" && day.score != null;
                const parts = seasonDayParts(day?.date);
                bar.classList.toggle("empty", !scored);
                col.classList.toggle("today", parts.isToday);
                if (scored) {
                    bar.style.height = `${Math.max(8, day.score)}%`;
                    scoreEl.textContent = String(day.score);
                    scoreEl.hidden = false;
                    bar.title = parts.isToday
                        ? `${day.date} (${t("season.today")}): ${day.score}`
                        : `${day.date}: ${day.score}`;
                } else {
                    bar.style.height = "";
                    scoreEl.textContent = "—";
                    scoreEl.hidden = false;
                    bar.title = day?.date || "";
                }
                weekdayEl.textContent = parts.isToday
                    ? t("season.today")
                    : parts.weekday;
                dateEl.textContent = parts.date;
                col.dataset.date = day?.date || "";
            }

            function makeSeasonCol(day) {
                const col = document.createElement("div");
                col.className = "season-col";
                const score = document.createElement("span");
                score.className = "season-score";
                score.setAttribute("aria-hidden", "true");
                const track = document.createElement("span");
                track.className = "season-track";
                const bar = document.createElement("span");
                bar.className = "season-bar";
                track.append(bar);
                const label = document.createElement("small");
                label.className = "season-label";
                const weekday = document.createElement("span");
                weekday.className = "season-weekday";
                const date = document.createElement("span");
                date.className = "season-date";
                label.append(weekday, date);
                col.append(score, track, label);
                fillSeasonCol(col, day);
                return col;
            }

            function renderSeason(days) {
                const chart = document.getElementById("season-chart");
                if (!chart) return;
                lastSeasonDays = days;
                const list =
                    Array.isArray(days) && days.length
                        ? days
                        : Array.from({ length: 9 }, () => null);

                if (chart.childElementCount === list.length) {
                    list.forEach((day, index) =>
                        fillSeasonCol(chart.children[index], day),
                    );
                } else {
                    chart.replaceChildren(
                        ...list.map((day) => makeSeasonCol(day)),
                    );
                }

                const scored = list.filter(
                    (day) => day?.status === "ready" && day.score != null,
                );
                chart.setAttribute(
                    "aria-label",
                    scored.length
                        ? scored
                              .map((day) => `${day.date}: ${day.score}`)
                              .join(", ")
                        : t("season.chartEmpty"),
                );

                const rangeEl = document.getElementById("season-range");
                const first = list.find((day) => day?.date)?.date;
                const last = [...list].reverse().find((day) => day?.date)?.date;
                if (rangeEl) {
                    rangeEl.textContent =
                        first && last
                            ? `${seasonDayParts(first).date} – ${seasonDayParts(last).date}`
                            : t("season.rangeFallback");
                }
            }

            function applyConditionsView(response) {
                lastConditions = response;
                if (!response || !Array.isArray(response.factors)) return;

                let anyFactorValue = false;
                for (const def of factorDefs) {
                    const factor = response.factors.find(
                        (f) => f.id === def.id,
                    );
                    const value = factor?.value ?? null;
                    const unit = factor?.unit ?? def.unit;
                    if (value !== null && value !== undefined) {
                        anyFactorValue = true;
                    }
                    setFactorValue(def.id, value, unit);
                }

                const stamp = formatFetchedAt(response.fetchedAt);
                if (stamp) {
                    animateStamp(stamp);
                } else {
                    animateStamp("--:--", t("condition.neverChecked"));
                }

                if (response.status === "ready" && response.score != null) {
                    animateScore(response.score);
                    if (scoreCaption) {
                        scoreCaption.textContent = t("condition.confidenceLow");
                    }
                    if (scorePanel) {
                        scorePanel.setAttribute(
                            "aria-label",
                            `${response.score} / 100`,
                        );
                    }
                    if (availabilityBadge) {
                        availabilityBadge.textContent = t(
                            "condition.availabilityReady",
                        );
                    }
                    conditionTitle.textContent = t("condition.scoredTitle");
                    conditionDescription.textContent = t(
                        "condition.scoredDescription",
                    );
                } else if (anyFactorValue) {
                    animateScore(null);
                    conditionTitle.textContent = t("condition.ingestedTitle");
                    conditionDescription.textContent = t(
                        "condition.ingestedDescription",
                    );
                } else {
                    animateScore(null);
                }

                if (weatherStatus) {
                    const nextState = anyFactorValue ? "connected" : "pending";
                    weatherStatus.className = nextState;
                    weatherStatus.textContent = t(
                        nextState === "connected"
                            ? "sources.connected"
                            : "sources.pending",
                    );
                }
            }

            async function loadConditions() {
                if (!window.__TAURI_INTERNALS__) return;

                try {
                    const response = await invoke("get_conditions_ui", {
                        cellId: pilotCellID,
                        speciesSlug: pilotSpeciesSlug,
                        targetDate: pilotTargetDate,
                    });
                    applyConditionsView(response);
                } catch (error) {
                    console.error("get_conditions_ui", error);
                }
            }

            async function loadSeason() {
                if (!window.__TAURI_INTERNALS__) {
                    renderSeason(null);
                    return;
                }

                try {
                    const response = await invoke("get_season_ui", {
                        cellId: pilotCellID,
                        speciesSlug: pilotSpeciesSlug,
                    });
                    renderSeason(response?.days ?? null);
                } catch (error) {
                    console.error("get_season_ui", error);
                    renderSeason(null);
                }
            }

            async function checkReadiness() {
                setState("checking");
                refreshButton.disabled = true;
                const spin = reducedMotion
                    ? null
                    : gsap.to(refreshIcon, {
                          rotate: "+=360",
                          duration: 0.75,
                          repeat: -1,
                          ease: "none",
                      });

                try {
                    const response = await fetch("/api/readyz", {
                        cache: "no-store",
                    });
                    const payload = await response.json();
                    const ok = response.ok && payload.status === "ready";
                    setState(ok ? "ready" : "unavailable");
                    if (ok) {
                        await loadConditions();
                        await loadSeason();
                    } else {
                        renderSeason(null);
                    }
                } catch {
                    setState("unavailable");
                    renderSeason(null);
                } finally {
                    spin?.kill();
                    gsap.set(refreshIcon, { rotate: 0 });
                    refreshButton.disabled = false;
                }
            }

            function initializeCursor() {
                if (
                    reducedMotion ||
                    !matchMedia("(hover: hover) and (pointer: fine)").matches
                ) {
                    return;
                }

                const cursor = document.getElementById("custom-cursor");
                root.classList.add("custom-cursor-enabled");
                const moveX = gsap.quickTo(cursor, "x", {
                    duration: 0.18,
                    ease: "power3.out",
                });
                const moveY = gsap.quickTo(cursor, "y", {
                    duration: 0.18,
                    ease: "power3.out",
                });

                window.addEventListener("pointermove", (event) => {
                    cursor.classList.add("active");
                    moveX(event.clientX);
                    moveY(event.clientY);
                });
                document.addEventListener("pointerover", (event) => {
                    const interactive =
                        event.target instanceof Element &&
                        event.target.closest("a, button");
                    gsap.to(cursor, {
                        scale: interactive ? 1.65 : 1,
                        rotate: interactive ? 12 : 0,
                        duration: 0.22,
                        ease: "power2.out",
                    });
                });
            }

            function initializePilotMap() {
                const container = document.getElementById("pilot-map");
                if (!container || container.dataset.mapReady === "1") return;

                const cellPolygon = {
                    type: "Feature",
                    properties: { label: "LJ-01" },
                    geometry: {
                        type: "Polygon",
                        coordinates: [
                            [
                                [pilotBounds.west, pilotBounds.south],
                                [pilotBounds.east, pilotBounds.south],
                                [pilotBounds.east, pilotBounds.north],
                                [pilotBounds.west, pilotBounds.north],
                                [pilotBounds.west, pilotBounds.south],
                            ],
                        ],
                    },
                };

                const map = new maplibregl.Map({
                    container,
                    style: {
                        version: 8,
                        sources: {
                            osm: {
                                type: "raster",
                                tiles: [
                                    "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                                ],
                                tileSize: 256,
                                attribution: "© OpenStreetMap",
                                maxzoom: 19,
                            },
                            bdl: {
                                type: "raster",
                                tiles: [
                                    "https://mapserver.bdl.lasy.gov.pl/arcgis/rest/services/WMS_BDL/MapServer/export?bbox={bbox-epsg-3857}&bboxSR=3857&imageSR=3857&size=256,256&format=png32&transparent=true&f=image",
                                ],
                                tileSize: 256,
                                attribution: "BDL",
                            },
                            cell: {
                                type: "geojson",
                                data: cellPolygon,
                            },
                        },
                        layers: [
                            {
                                id: "osm",
                                type: "raster",
                                source: "osm",
                            },
                            {
                                id: "bdl",
                                type: "raster",
                                source: "bdl",
                                paint: { "raster-opacity": 0.72 },
                            },
                            {
                                id: "cell-fill",
                                type: "fill",
                                source: "cell",
                                paint: {
                                    "fill-color": "#E4772D",
                                    "fill-opacity": 0.12,
                                },
                            },
                            {
                                id: "cell-line",
                                type: "line",
                                source: "cell",
                                paint: {
                                    "line-color": "#E4772D",
                                    "line-width": 2,
                                },
                            },
                        ],
                    },
                    center: [pilotCenter.lon, pilotCenter.lat],
                    zoom: 10,
                    minZoom: 8,
                    maxZoom: 15,
                    attributionControl: false,
                });

                map.addControl(
                    new maplibregl.NavigationControl({ showCompass: false }),
                    "top-right",
                );
                map.addControl(
                    new maplibregl.AttributionControl({ compact: true }),
                );

                map.on("load", () => {
                    // Wider than the cell alone — surrounding forest context, not a tight crop.
                    map.fitBounds(
                        [
                            [pilotBounds.west, pilotBounds.south],
                            [pilotBounds.east, pilotBounds.north],
                        ],
                        {
                            padding: { top: 48, bottom: 48, left: 56, right: 56 },
                            maxZoom: 11.2,
                            duration: 0,
                        },
                    );

                    const marker = document.createElement("div");
                    marker.className = "cell-map-label";
                    marker.textContent = "LJ-01";
                    new maplibregl.Marker({
                        element: marker,
                        anchor: "center",
                    })
                        .setLngLat([pilotCenter.lon, pilotCenter.lat])
                        .addTo(map);
                });

                container.dataset.mapReady = "1";
                window.addEventListener(
                    "resize",
                    () => {
                        map.resize();
                    },
                    { passive: true },
                );
            }

            applyTranslations();
            initializeCursor();
            initializePilotMap();
            renderSeason(null);
            checkReadiness();
            refreshButton.addEventListener("click", checkReadiness);
            window.setInterval(checkReadiness, 30_000);

            if (!reducedMotion) {
                gsap.from(".site-header", {
                    y: -14,
                    opacity: 0,
                    duration: 0.55,
                    ease: "power3.out",
                });
                gsap.from(
                    ".intro, .condition-card, .section-block, .detail-card, footer",
                    {
                        y: 18,
                        opacity: 0,
                        duration: 0.62,
                        stagger: 0.07,
                        ease: "power3.out",
                    },
                );
            }
        </script>
    </body>
</html>
