---
import "../styles/global.css";
import MushroomIcon from "../components/MushroomIcon.astro";

const factors = [
    { label: "factors.rain", period: "factors.rainPeriod", unit: "mm" },
    { label: "factors.soil", period: "factors.soilPeriod", unit: "°C" },
    { label: "factors.humidity", period: "factors.humidityPeriod", unit: "%" },
];

const bdlMapUrl =
    "https://mapserver.bdl.lasy.gov.pl/arcgis/rest/services/WMS_BDL/MapServer/export?bbox=2463133,6544060,2477133,6558060&bboxSR=3857&imageSR=3857&size=900,500&format=png32&transparent=false&f=image";
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta
            id="page-description"
            name="description"
            content="Oentike — przejrzysta analiza warunków grzybowych dla polskich lasów."
        />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/oentike-logo.svg" />
        <title>Oentike - warunki grzybowe</title>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                try {
                    root.dataset.theme =
                        localStorage.getItem("oentike-theme") ||
                        (matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light");
                    root.dataset.size =
                        localStorage.getItem("oentike-size") || "medium";
                    root.dataset.contrast =
                        localStorage.getItem("oentike-contrast") || "normal";
                } catch {
                    root.dataset.theme = "light";
                    root.dataset.size = "medium";
                    root.dataset.contrast = "normal";
                }
            })();
        </script>
    </head>
    <body>
        <header class="site-header">
            <a
                class="brand"
                href="/"
                aria-label="Oentike — strona główna"
                data-i18n-aria="meta.home"
            >
                <span>Oen</span>
                <MushroomIcon class="brand-mark" variant="brand" />
                <span>ke</span>
            </a>

            <nav aria-label="Główna nawigacja" data-i18n-aria="meta.navigation">
                <a href="#warunki" data-i18n="nav.conditions">Warunki</a>
                <a href="#obszar" data-i18n="nav.area">Obszar</a>
                <a href="#zrodla" data-i18n="nav.sources">Źródła</a>
            </nav>

            <div
                class="ux-controls"
                aria-label="Ustawienia wyglądu"
                data-i18n-aria="controls.appearance"
            >
                <div
                    class="language-control"
                    role="group"
                    aria-label="Język"
                    data-i18n-aria="controls.language"
                >
                    <button type="button" data-language="pl">PL</button>
                    <button type="button" data-language="en">EN</button>
                </div>
                <div
                    class="size-control"
                    role="group"
                    aria-label="Rozmiar interfejsu"
                    data-i18n-aria="controls.size"
                >
                    <button
                        type="button"
                        data-size="small"
                        aria-label="Mały interfejs"
                    >
                        <MushroomIcon class="small" />
                    </button>
                    <button
                        type="button"
                        data-size="medium"
                        aria-label="Średni interfejs"
                    >
                        <MushroomIcon class="medium" />
                    </button>
                    <button
                        type="button"
                        data-size="large"
                        aria-label="Duży interfejs"
                    >
                        <MushroomIcon class="large" />
                    </button>
                </div>
                <button
                    class="contrast-toggle"
                    id="contrast-toggle"
                    type="button"
                    aria-label="Włącz wysoki kontrast"
                    aria-pressed="false"
                >
                    <MushroomIcon class="contrast" />
                </button>
                <button
                    class="theme-toggle"
                    id="theme-toggle"
                    type="button"
                    aria-label="Włącz ciemny motyw"
                    aria-pressed="false"
                >
                    <MushroomIcon class="theme" variant="theme" />
                </button>
            </div>
        </header>

        <main>
            <section class="intro">
                <div>
                    <p class="eyebrow" id="current-date">LASY JANOWSKIE</p>
                    <h1 data-i18n="intro.title">Warunki dla grzybów</h1>
                    <p class="lead" data-i18n="intro.lead">
                        Wyjaśnialna ocena oparta na pogodzie — bez zgadywania i
                        bez ujawniania dokładnych miejsc.
                    </p>
                </div>
                <button
                    class="refresh-button"
                    id="refresh-button"
                    type="button"
                >
                    <svg
                        class="refresh-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M19.3 8.2A8 8 0 1 0 20 15"></path>
                        <path d="M20 4v5.5h-5.5"></path>
                    </svg>
                    <span data-i18n="controls.refresh">Odśwież</span>
                </button>
            </section>

            <section class="condition-card" id="warunki">
                <div class="condition-copy">
                    <div class="section-heading">
                        <p class="eyebrow" data-i18n="condition.eyebrow">
                            OCENA WARUNKÓW
                        </p>
                        <span
                            class="availability"
                            data-i18n="condition.unavailable">Brak danych</span
                        >
                    </div>
                    <h2
                        id="condition-title"
                        data-i18n="condition.checkingTitle"
                    >
                        Sprawdzamy gotowość systemu.
                    </h2>
                    <p
                        id="condition-description"
                        data-i18n="condition.checkingDescription"
                    >
                        Ocena pojawi się dopiero po pobraniu kompletnych danych
                        pogodowych.
                    </p>
                    <dl class="metadata">
                        <div>
                            <dt data-i18n="condition.species">Gatunek</dt>
                            <dd>Boletus edulis</dd>
                        </div>
                        <div>
                            <dt data-i18n="condition.area">Obszar</dt>
                            <dd>Lasy Janowskie 01</dd>
                        </div>
                        <div>
                            <dt data-i18n="condition.updated">Aktualizacja</dt>
                            <dd
                                id="last-check"
                                class="animated-time"
                                aria-live="polite"
                            >
                                --:--
                            </dd>
                        </div>
                    </dl>
                </div>

                <div
                    class="score"
                    aria-label="Wynik nie został jeszcze obliczony"
                >
                    <span>—</span>
                    <small>/ 100</small>
                    <p data-i18n="condition.notCalculated">Nie obliczono</p>
                </div>
            </section>

            <section class="section-block" aria-labelledby="factors-title">
                <div class="section-title">
                    <div>
                        <p class="eyebrow" data-i18n="factors.eyebrow">
                            DANE WEJŚCIOWE
                        </p>
                        <h2 id="factors-title" data-i18n="factors.title">
                            Składniki oceny
                        </h2>
                    </div>
                    <p data-i18n="factors.note">
                        Brak próbki oznacza brak wyniku.
                    </p>
                </div>

                <div class="factor-list">
                    {
                        factors.map((factor) => (
                            <article class="factor-row">
                                <div>
                                    <strong data-i18n={factor.label} />
                                    <span data-i18n={factor.period} />
                                </div>
                                <p>
                                    <b>—</b> {factor.unit}
                                </p>
                                <small data-i18n="factors.noSamples">
                                    Brak próbek
                                </small>
                            </article>
                        ))
                    }
                </div>
            </section>

            <div class="details-grid">
                <section class="detail-card" id="obszar">
                    <div class="section-title compact">
                        <div>
                            <p class="eyebrow" data-i18n="pilot.eyebrow">
                                OBSZAR PILOTAŻOWY
                            </p>
                            <h2>Lasy Janowskie 01</h2>
                        </div>
                        <span class="tag">10 × 10 km</span>
                    </div>

                    <div class="cell-preview">
                        <img
                            src={bdlMapUrl}
                            alt="Mapa oddziałów leśnych w rejonie Lasów Janowskich"
                            data-i18n-alt="pilot.mapAlt"
                            loading="lazy"
                            referrerpolicy="no-referrer"
                        />
                        <div class="selected-cell"><span>LJ-01</span></div>
                    </div>
                    <p class="caption">
                        <span data-i18n="pilot.sourcePrefix">Dane mapowe:</span>
                        <a
                            href="https://bdl.lasy.gov.pl/portal/uslugi-ogc?v=4"
                            target="_blank"
                            rel="noreferrer"
                        >
                            Bank Danych o Lasach
                        </a>.
                        <span data-i18n="pilot.privacy"
                            >Analiza używa komórki, nie dokładnych punktów.</span
                        >
                    </p>
                </section>

                <section class="detail-card" id="zrodla">
                    <div class="section-title compact">
                        <div>
                            <p class="eyebrow" data-i18n="sources.eyebrow">
                                INFRASTRUKTURA
                            </p>
                            <h2 data-i18n="sources.title">Źródła</h2>
                        </div>
                    </div>

                    <div class="source-list">
                        <div class="source-row">
                            <span class="source-dot"></span>
                            <div>
                                <strong>PostGIS</strong>
                                <small data-i18n="sources.postgis"
                                    >geometria i szeregi czasowe</small
                                >
                            </div>
                            <b id="database-status" data-i18n="sources.checking"
                                >Sprawdzanie</b
                            >
                        </div>
                        <div class="source-row">
                            <span class="source-dot"></span>
                            <div>
                                <strong>Bank Danych o Lasach</strong>
                                <small data-i18n="sources.bdl"
                                    >granice oddziałów · OGC WMS</small
                                >
                            </div>
                            <b class="connected" data-i18n="sources.official"
                                >Oficjalne</b
                            >
                        </div>
                        <div class="source-row">
                            <span class="source-dot muted"></span>
                            <div>
                                <strong>Open-Meteo</strong>
                                <small data-i18n="sources.weather"
                                    >historia i prognoza pogody</small
                                >
                            </div>
                            <b class="pending" data-i18n="sources.pending"
                                >Do podłączenia</b
                            >
                        </div>
                    </div>
                </section>
            </div>

            <footer>
                <p data-i18n="footer.promise">
                    Każda przyszła ocena pokaże pochodzenie danych, wersję
                    algorytmu i poziom pewności.
                </p>
                <span data-i18n="footer.version"
                    >Oentike · wersja rozwojowa</span
                >
            </footer>
        </main>

        <div class="theme-wipe" id="theme-wipe" aria-hidden="true"></div>
        <div class="custom-cursor" id="custom-cursor" aria-hidden="true">
            <span></span>
        </div>

        <script>
            import { gsap } from "gsap";
            import i18next from "i18next";
            import { resources } from "../i18n";

            const root = document.documentElement;
            const conditionTitle = document.getElementById("condition-title");
            const conditionDescription = document.getElementById(
                "condition-description",
            );
            const databaseStatus = document.getElementById("database-status");
            const lastCheck = document.getElementById("last-check");
            const refreshButton = document.getElementById("refresh-button");
            const refreshIcon = document.querySelector(".refresh-icon");
            const themeToggle = document.getElementById("theme-toggle");
            const contrastToggle = document.getElementById("contrast-toggle");
            const themeWipe = document.getElementById("theme-wipe");
            const sizeButtons = document.querySelectorAll("[data-size]");
            const languageButtons =
                document.querySelectorAll("[data-language]");
            const reducedMotion = matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            let readinessState = "checking";
            let displayedTime = "";

            const savedLanguage = localStorage.getItem("oentike-language");
            const browserLanguage = navigator.language
                .toLowerCase()
                .startsWith("en")
                ? "en"
                : "pl";
            await i18next.init({
                lng: savedLanguage || browserLanguage,
                fallbackLng: "pl",
                resources,
                interpolation: { escapeValue: false },
            });

            const t = (key) => i18next.t(key);
            const locale = () =>
                i18next.language === "en" ? "en-GB" : "pl-PL";

            function applyTranslations() {
                root.lang = i18next.language;
                document.title = t("meta.title");
                document
                    .getElementById("page-description")
                    .setAttribute("content", t("meta.description"));
                document.querySelectorAll("[data-i18n]").forEach((element) => {
                    element.textContent = t(element.dataset.i18n);
                });
                document
                    .querySelectorAll("[data-i18n-aria]")
                    .forEach((element) => {
                        element.setAttribute(
                            "aria-label",
                            t(element.dataset.i18nAria),
                        );
                    });
                document
                    .querySelectorAll("[data-i18n-alt]")
                    .forEach((element) => {
                        element.setAttribute("alt", t(element.dataset.i18nAlt));
                    });

                const date = new Intl.DateTimeFormat(locale(), {
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                }).format(new Date());
                document.getElementById("current-date").textContent =
                    `${date} · Lasy Janowskie`.toLocaleUpperCase(locale());

                setState(readinessState);
                syncPreferences();
            }

            function syncPreferences() {
                const dark = root.dataset.theme === "dark";
                const highContrast = root.dataset.contrast === "high";
                const activeSize = root.dataset.size || "medium";
                const sizeLabels = {
                    small: t("controls.small"),
                    medium: t("controls.medium"),
                    large: t("controls.large"),
                };

                themeToggle.setAttribute("aria-pressed", String(dark));
                themeToggle.setAttribute(
                    "aria-label",
                    dark ? t("controls.light") : t("controls.dark"),
                );
                themeToggle.title = themeToggle.getAttribute("aria-label");

                contrastToggle.setAttribute(
                    "aria-pressed",
                    String(highContrast),
                );
                contrastToggle.setAttribute(
                    "aria-label",
                    highContrast
                        ? t("controls.contrastOff")
                        : t("controls.contrastOn"),
                );
                contrastToggle.title =
                    contrastToggle.getAttribute("aria-label");

                sizeButtons.forEach((button) => {
                    const size = button.dataset.size;
                    button.setAttribute(
                        "aria-pressed",
                        String(size === activeSize),
                    );
                    button.setAttribute("aria-label", sizeLabels[size]);
                    button.title = sizeLabels[size];
                });
                languageButtons.forEach((button) => {
                    button.setAttribute(
                        "aria-pressed",
                        String(button.dataset.language === i18next.language),
                    );
                });
            }

            function animatePreferenceChange(callback) {
                if (reducedMotion) {
                    callback();
                    return;
                }

                gsap.timeline()
                    .to("main", {
                        opacity: 0.65,
                        y: 3,
                        duration: 0.12,
                        ease: "power2.in",
                    })
                    .add(callback)
                    .to("main", {
                        opacity: 1,
                        y: 0,
                        duration: 0.28,
                        ease: "power2.out",
                    });
            }

            sizeButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    animatePreferenceChange(() => {
                        root.dataset.size = button.dataset.size;
                        localStorage.setItem(
                            "oentike-size",
                            button.dataset.size,
                        );
                        syncPreferences();
                    });
                    if (!reducedMotion) {
                        gsap.fromTo(
                            button.querySelector(".control-mushroom"),
                            { scale: 0.72, rotate: -7 },
                            {
                                scale: 1,
                                rotate: 0,
                                duration: 0.45,
                                ease: "back.out(2.2)",
                            },
                        );
                    }
                });
            });

            languageButtons.forEach((button) => {
                button.addEventListener("click", async () => {
                    await i18next.changeLanguage(button.dataset.language);
                    localStorage.setItem(
                        "oentike-language",
                        button.dataset.language,
                    );
                    applyTranslations();
                    if (!reducedMotion) {
                        gsap.fromTo(
                            "[data-i18n]",
                            { opacity: 0.35, y: 2 },
                            {
                                opacity: 1,
                                y: 0,
                                duration: 0.28,
                                stagger: 0.006,
                            },
                        );
                    }
                });
            });

            themeToggle.addEventListener("click", () => {
                const nextTheme =
                    root.dataset.theme === "dark" ? "light" : "dark";
                const targetColor =
                    nextTheme === "dark" ? "#101612" : "#f6f5ef";

                if (reducedMotion) {
                    root.dataset.theme = nextTheme;
                    localStorage.setItem("oentike-theme", nextTheme);
                    syncPreferences();
                    return;
                }

                const bounds = themeToggle.getBoundingClientRect();
                gsap.set(themeWipe, {
                    display: "block",
                    opacity: 1,
                    scale: 0,
                    x: bounds.left + bounds.width / 2,
                    y: bounds.top + bounds.height / 2,
                    backgroundColor: targetColor,
                });
                gsap.timeline()
                    .to(themeToggle.querySelector(".control-mushroom"), {
                        scaleY: 0.74,
                        scaleX: 1.12,
                        duration: 0.16,
                        ease: "power2.in",
                    })
                    .to(
                        themeWipe,
                        { scale: 120, duration: 0.52, ease: "power3.inOut" },
                        0,
                    )
                    .call(
                        () => {
                            root.dataset.theme = nextTheme;
                            localStorage.setItem("oentike-theme", nextTheme);
                            syncPreferences();
                        },
                        [],
                        0.3,
                    )
                    .to(themeWipe, { opacity: 0, duration: 0.2 })
                    .to(
                        themeToggle.querySelector(".control-mushroom"),
                        {
                            scaleX: 1,
                            scaleY: 1,
                            duration: 0.38,
                            ease: "elastic.out(1, 0.45)",
                        },
                        0.32,
                    )
                    .set(themeWipe, { display: "none", scale: 0, opacity: 1 });
            });

            contrastToggle.addEventListener("click", () => {
                const nextContrast =
                    root.dataset.contrast === "high" ? "normal" : "high";
                root.dataset.contrast = nextContrast;
                localStorage.setItem("oentike-contrast", nextContrast);
                syncPreferences();
                if (!reducedMotion) {
                    gsap.fromTo(
                        contrastToggle.querySelector(".control-mushroom"),
                        { rotateY: 0 },
                        { rotateY: 360, duration: 0.55, ease: "power3.inOut" },
                    );
                }
            });

            function animateTime(date) {
                const value = new Intl.DateTimeFormat(locale(), {
                    hour: "2-digit",
                    minute: "2-digit",
                }).format(date);

                if (value === displayedTime) {
                    return;
                }
                displayedTime = value;

                lastCheck.replaceChildren(
                    ...Array.from(value, (character) => {
                        const span = document.createElement("span");
                        span.textContent = character;
                        span.className = /\d/.test(character)
                            ? "time-digit"
                            : "time-separator";
                        return span;
                    }),
                );
                lastCheck.setAttribute("aria-label", value);

                if (!reducedMotion) {
                    gsap.from(lastCheck.querySelectorAll(".time-digit"), {
                        yPercent: 90,
                        opacity: 0,
                        duration: 0.42,
                        stagger: 0.025,
                        ease: "back.out(1.7)",
                    });
                }
            }

            function startLiveClock() {
                animateTime(new Date());
                const untilNextMinute = 60_000 - (Date.now() % 60_000) + 50;
                window.setTimeout(() => {
                    animateTime(new Date());
                    window.setInterval(() => animateTime(new Date()), 60_000);
                }, untilNextMinute);
            }

            function setState(state) {
                readinessState = state;
                if (state === "ready") {
                    conditionTitle.textContent = t("condition.readyTitle");
                    conditionDescription.textContent = t(
                        "condition.readyDescription",
                    );
                    databaseStatus.textContent = t("sources.connected");
                    databaseStatus.className = "connected";
                    return;
                }

                if (state === "unavailable") {
                    conditionTitle.textContent = t("condition.offlineTitle");
                    conditionDescription.textContent = t(
                        "condition.offlineDescription",
                    );
                    databaseStatus.textContent = t("sources.unavailable");
                    databaseStatus.className = "disconnected";
                    return;
                }

                conditionTitle.textContent = t("condition.checkingTitle");
                conditionDescription.textContent = t(
                    "condition.checkingDescription",
                );
                databaseStatus.textContent = t("sources.checking");
                databaseStatus.className = "";
            }

            async function checkReadiness() {
                setState("checking");
                refreshButton.disabled = true;
                const spin = reducedMotion
                    ? null
                    : gsap.to(refreshIcon, {
                          rotate: "+=360",
                          duration: 0.75,
                          repeat: -1,
                          ease: "none",
                      });

                try {
                    const response = await fetch("/api/readyz", {
                        cache: "no-store",
                    });
                    const payload = await response.json();
                    setState(
                        response.ok && payload.status === "ready"
                            ? "ready"
                            : "unavailable",
                    );
                } catch {
                    setState("unavailable");
                } finally {
                    spin?.kill();
                    gsap.set(refreshIcon, { rotate: 0 });
                    refreshButton.disabled = false;
                }
            }

            function initializeCursor() {
                if (
                    reducedMotion ||
                    !matchMedia("(hover: hover) and (pointer: fine)").matches
                ) {
                    return;
                }

                const cursor = document.getElementById("custom-cursor");
                root.classList.add("custom-cursor-enabled");
                const moveX = gsap.quickTo(cursor, "x", {
                    duration: 0.18,
                    ease: "power3.out",
                });
                const moveY = gsap.quickTo(cursor, "y", {
                    duration: 0.18,
                    ease: "power3.out",
                });

                window.addEventListener("pointermove", (event) => {
                    cursor.classList.add("active");
                    moveX(event.clientX);
                    moveY(event.clientY);
                });
                document.addEventListener("pointerover", (event) => {
                    const interactive =
                        event.target instanceof Element &&
                        event.target.closest("a, button");
                    gsap.to(cursor, {
                        scale: interactive ? 1.65 : 1,
                        rotate: interactive ? 12 : 0,
                        duration: 0.22,
                        ease: "power2.out",
                    });
                });
            }

            applyTranslations();
            initializeCursor();
            startLiveClock();
            checkReadiness();
            refreshButton.addEventListener("click", checkReadiness);
            window.setInterval(checkReadiness, 30_000);

            if (!reducedMotion) {
                gsap.from(".site-header", {
                    y: -14,
                    opacity: 0,
                    duration: 0.55,
                    ease: "power3.out",
                });
                gsap.from(
                    ".intro, .condition-card, .section-block, .detail-card, footer",
                    {
                        y: 18,
                        opacity: 0,
                        duration: 0.62,
                        stagger: 0.07,
                        ease: "power3.out",
                    },
                );
            }
        </script>
    </body>
</html>
