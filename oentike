#!/bin/sh
# One entry point; paths with spaces and invocation from outside the repo work.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
command_name=${1:-dev}
if [ "$#" -gt 0 ]; then shift; fi
case "$command_name" in
 dev|field|setup|doctor|check|bench|atlas) ;;
 stop) command_name=oentike:down ;;
 *) printf 'Użycie: ./oentike [dev|field|setup|doctor|check|bench|atlas|stop]\n' >&2; exit 2 ;;
esac
if command -v mise >/dev/null 2>&1; then
 exec mise exec -- task "$command_name" "$@"
fi
if ! command -v task >/dev/null 2>&1; then
 printf 'Brak task. Zainstaluj mise, następnie wykonaj: mise trust && mise install\n' >&2
 exit 1
fi
exec task "$command_name" "$@"
